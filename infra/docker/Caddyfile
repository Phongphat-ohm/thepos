{$POS_SITE} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    @admin path /server-admin*
    handle @admin {
        @blocked not remote_ip private_ranges 127.0.0.1 ::1
        respond @blocked 403
        reverse_proxy api:3000
    }

    handle {
        reverse_proxy api:3000
    }
}
