generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServerSecurityState {
  id                  String   @id @default(uuid()) @db.Uuid
  singleton           Boolean  @unique @default(true)
  connectKeyEncrypted String   @map("connect_key_encrypted")
  connectKeyHash      String   @map("connect_key_hash") @db.Char(64)
  keyVersion          Int      @default(1) @map("key_version")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("server_security_state")
}

model Store {
  id        String   @id @default(uuid()) @db.Uuid
  singleton Boolean  @unique @default(true)
  name      String   @db.VarChar(120)
  address   String?  @db.VarChar(400)
  taxId     String?  @map("tax_id") @db.VarChar(13)
  vatActive Boolean  @default(false) @map("vat_active")
  vatRate Decimal? @map("vat_rate") @db.Decimal(5, 2)
  receiptHeader String? @map("receipt_header") @db.VarChar(300)
  receiptFooter String? @map("receipt_footer") @db.VarChar(300)
  receiptLogo String? @map("receipt_logo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  users     User[]
  devices   Device[]
  auditLogs AuditLog[]
  categories Category[]
  products Product[]
  suppliers Supplier[]
  goodsReceipts GoodsReceipt[]
  stockCounts StockCount[]
  catalogImports CatalogImport[]
  sales Sale[]
  salesRequests SaleRequest[]
  members Member[]
  heldSales HeldSale[]
  saleReturns SaleReturn[]
  accountingPeriods AccountingPeriod[]
  dividendRules DividendRule[]
  payouts Payout[]
  cashShifts CashShift[]

  @@map("stores")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  storeId      String    @map("store_id") @db.Uuid
  store        Store     @relation(fields: [storeId], references: [id])
  username     String    @unique @db.VarChar(64)
  name         String    @db.VarChar(120)
  passwordHash String    @map("password_hash")
  pinHash      String    @map("pin_hash")
  disabledAt    DateTime? @map("disabled_at") @db.Timestamptz(3)
  loginFails    Int       @default(0) @map("login_fails")
  loginUntil    DateTime? @map("login_until") @db.Timestamptz(3)
  approvalFails Int       @default(0) @map("approval_fails")
  approvalUntil DateTime? @map("approval_until") @db.Timestamptz(3)
  roles        UserRole[]
  sessions     Session[]
  auditLogs    AuditLog[]
  submittedCounts StockCount[] @relation("SubmittedCounts")
  reviewedCounts StockCount[] @relation("ReviewedCounts")
  sales Sale[]
  approvals ApprovalDecision[]

  @@index([storeId])
  approvedShareEntries ShareTransaction[]
  lockedPeriods AccountingPeriod[]
  dividendRuns DividendRun[]
  payouts Payout[]
  purchaseAdjustments PurchaseAdjustment[]
  cashShifts CashShift[] @relation("ShiftCashier")
  approvedShifts CashShift[] @relation("ShiftApprover")
  cashMovements CashMovement[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  code  String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Device {
  cashShifts CashShift[]
  id         String    @id @default(uuid()) @db.Uuid
  storeId    String    @map("store_id") @db.Uuid
  store      Store     @relation(fields: [storeId], references: [id])
  name       String    @db.VarChar(120)
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  pinHash       String?   @map("pin_hash")
  isWebDevice   Boolean   @default(false) @map("is_web_device")
  disabledAt    DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions   Session[]
  sales Sale[]
  approvalFails Int @default(0) @map("approval_fails")
  approvalUntil DateTime? @map("approval_until") @db.Timestamptz(3)

  @@index([storeId])
  @@map("devices")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id])
  deviceId    String    @map("device_id") @db.Uuid
  device      Device    @relation(fields: [deviceId], references: [id])
  refreshHash String    @unique @map("refresh_hash") @db.Char(64)
  generation  Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(3)
  pinFails    Int       @default(0) @map("pin_fails")
  pinUntil    DateTime? @map("pin_until") @db.Timestamptz(3)

  @@index([userId])
  @@index([deviceId])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  store     Store    @relation(fields: [storeId], references: [id])
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  deviceId   String?  @map("device_id") @db.Uuid
  deviceName String?  @map("device_name") @db.VarChar(120)
  event      String
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([storeId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model Category {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @map("store_id") @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id])
  name    String @db.VarChar(120)
  products Product[]

  @@unique([storeId, name])
  @@map("categories")
}

model Supplier {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @map("store_id") @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id])
  name    String @db.VarChar(120)
  contactName String? @map("contact_name") @db.VarChar(120)
  phone String? @db.VarChar(40)
  email String? @db.VarChar(254)
  address String? @db.VarChar(400)
  isActive Boolean @default(true) @map("is_active")
  goodsReceipts GoodsReceipt[]
  lots StockLot[]

  @@unique([storeId, name])
  @@map("suppliers")
}

model Product {
  id              String   @id @default(uuid()) @db.Uuid
  storeId         String   @map("store_id") @db.Uuid
  store           Store    @relation(fields: [storeId], references: [id])
  categoryId      String   @map("category_id") @db.Uuid
  category        Category @relation(fields: [categoryId], references: [id])
  sku             String   @db.VarChar(50)
  name            String   @db.VarChar(255)
  description     String?
  baseUnit        String   @map("base_unit") @db.VarChar(50)
  costPrice       Decimal  @map("cost_price") @db.Decimal(14, 4)
  regularPrice    Decimal  @map("regular_price") @db.Decimal(12, 2)
  memberPrice     Decimal  @map("member_price") @db.Decimal(12, 2)
  isActive        Boolean  @default(true) @map("is_active")
  trackStock      Boolean  @default(true) @map("track_stock")
  trackExpiration Boolean  @default(false) @map("track_expiration")
  barcodes        ProductBarcode[]
  units           ProductUnitConversion[]
  lots            StockLot[]
  saleItems       SaleItem[]

  @@unique([storeId, sku])
  @@index([categoryId])
  @@map("products")
}

model ProductBarcode {
  code      String   @id @db.VarChar(100)
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_barcodes")
}

model ProductUnitConversion {
  productId  String  @map("product_id") @db.Uuid
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String  @db.VarChar(50)
  multiplier Decimal @db.Decimal(12, 3)

  @@id([productId, name])
  @@map("product_unit_conversions")
}

model GoodsReceipt {
  id             String    @id @default(uuid()) @db.Uuid
  storeId        String    @map("store_id") @db.Uuid
  store          Store     @relation(fields: [storeId], references: [id])
  supplierId     String    @map("supplier_id") @db.Uuid
  supplier       Supplier  @relation(fields: [supplierId], references: [id])
  idempotencyKey String    @map("idempotency_key") @db.Uuid
  payloadHash    String    @map("payload_hash") @db.Char(64)
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  lots           StockLot[]

  @@unique([storeId, idempotencyKey])
  @@index([storeId, receivedAt])
  @@map("goods_receipts")
}

model StockLot {
  id                String          @id @default(uuid()) @db.Uuid
  productId         String          @map("product_id") @db.Uuid
  product           Product         @relation(fields: [productId], references: [id])
  supplierId        String          @map("supplier_id") @db.Uuid
  supplier          Supplier        @relation(fields: [supplierId], references: [id])
  goodsReceiptId    String          @map("goods_receipt_id") @db.Uuid
  goodsReceipt      GoodsReceipt    @relation(fields: [goodsReceiptId], references: [id])
  lotNumber         String          @map("lot_number") @db.VarChar(100)
  initialQuantity   Decimal         @map("initial_quantity") @db.Decimal(12, 3)
  remainingQuantity Decimal         @map("remaining_quantity") @db.Decimal(12, 3)
  unitCost          Decimal         @map("unit_cost") @db.Decimal(14, 4)
  expirationDate    DateTime?       @map("expiration_date") @db.Date
  receivedAt        DateTime        @map("received_at") @db.Timestamptz(3)
  movements         StockMovement[]
  adjustments       StockAdjustment[]
  saleAllocations    SaleItemLotAllocation[]

  @@index([productId, expirationDate, receivedAt, id])
  @@index([goodsReceiptId])
  @@map("stock_lots")
}

model StockMovement {
  id        String   @id @default(uuid()) @db.Uuid
  lotId     String   @map("lot_id") @db.Uuid
  lot       StockLot @relation(fields: [lotId], references: [id])
  kind      String   @db.VarChar(32)
  quantity  Decimal  @db.Decimal(12, 3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  adjustmentId String? @unique @map("adjustment_id") @db.Uuid
  adjustment StockAdjustment? @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  saleItemId String? @map("sale_item_id") @db.Uuid
  saleItem SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  returnAllocationId String? @unique @map("return_allocation_id") @db.Uuid
  returnAllocation SaleReturnAllocation? @relation(fields: [returnAllocationId], references: [id], onDelete: Restrict)

  @@index([lotId, createdAt])
  @@index([createdAt])
  @@index([saleItemId])
  @@map("stock_movements")
}

model StockCount {
  id String @id @default(uuid()) @db.Uuid
  storeId String @map("store_id") @db.Uuid
  store Store @relation(fields: [storeId], references: [id])
  submittedById String @map("submitted_by_id") @db.Uuid
  submittedBy User @relation("SubmittedCounts", fields: [submittedById], references: [id])
  reviewedById String? @map("reviewed_by_id") @db.Uuid
  reviewedBy User? @relation("ReviewedCounts", fields: [reviewedById], references: [id], onDelete: Restrict)
  status String @default("PENDING") @db.VarChar(12)
  reason String @db.VarChar(400)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(3)
  idempotencyKey String @map("idempotency_key") @db.Uuid
  payloadHash String @map("payload_hash") @db.Char(64)
  adjustments StockAdjustment[]

  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt, id])
  @@map("stock_counts")
}

model StockAdjustment {
  id String @id @default(uuid()) @db.Uuid
  stockCountId String @map("stock_count_id") @db.Uuid
  stockCount StockCount @relation(fields: [stockCountId], references: [id])
  lotId String @map("lot_id") @db.Uuid
  lot StockLot @relation(fields: [lotId], references: [id])
  expectedQuantity Decimal @map("expected_quantity") @db.Decimal(12, 3)
  countedQuantity Decimal @map("counted_quantity") @db.Decimal(12, 3)
  movement StockMovement?

  @@unique([stockCountId, lotId])
  @@index([lotId])
  @@map("stock_adjustments")
}

model CatalogImport {
  storeId String @map("store_id") @db.Uuid
  store Store @relation(fields: [storeId], references: [id])
  idempotencyKey String @map("idempotency_key") @db.Uuid
  payloadHash String @map("payload_hash") @db.Char(64)
  createdCount Int @map("created_count")

  @@id([storeId, idempotencyKey])
  @@map("catalog_imports")
}

model Sale {
  cashMovement CashMovement?
  id String @id @default(uuid()) @db.Uuid
  storeId String @map("store_id") @db.Uuid
  store Store @relation(fields: [storeId], references: [id])
  cashierId String @map("cashier_id") @db.Uuid
  cashier User @relation(fields: [cashierId], references: [id])
  terminalId String @map("terminal_id") @db.Uuid
  terminal Device @relation(fields: [terminalId], references: [id])
  invoiceNumber String @unique @map("invoice_number") @db.VarChar(50)
  status String @default("COMPLETED") @db.VarChar(30)
  subtotal Decimal @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal Decimal @default(0) @map("tax_total") @db.Decimal(12, 2)
  netTotal Decimal @map("net_total") @db.Decimal(12, 2)
  completedAt DateTime @map("completed_at") @db.Timestamptz(3)
  items SaleItem[]
  payments SalePayment[]
  request SaleRequest?
  memberId String? @map("member_id") @db.Uuid
  member Member? @relation(fields: [memberId], references: [id], onDelete: Restrict)
  memberName String? @map("member_name") @db.VarChar(120)
  storeName String? @map("store_name") @db.VarChar(120)
  cashierName String? @map("cashier_name") @db.VarChar(120)
  billDiscount Decimal @default(0) @map("bill_discount") @db.Decimal(12, 2)
  approval ApprovalDecision?
  returns SaleReturn[]
  purchaseEntry MemberPurchaseLedger?

  @@index([storeId, completedAt, id])
  @@index([cashierId])
  @@index([terminalId])
  @@map("sales")
}

model SaleItem {
  categoryName String? @map("category_name") @db.VarChar(120)
  id String @id @default(uuid()) @db.Uuid
  saleId String @map("sale_id") @db.Uuid
  sale Sale @relation(fields: [saleId], references: [id])
  productId String @map("product_id") @db.Uuid
  product Product @relation(fields: [productId], references: [id])
  lineNumber Int @map("line_number")
  sku String @db.VarChar(50)
  name String @db.VarChar(255)
  unit String @db.VarChar(50)
  baseUnit String @map("base_unit") @db.VarChar(50)
  quantity Decimal @db.Decimal(12, 3)
  baseQuantity Decimal @map("base_quantity") @db.Decimal(12, 3)
  basePrice Decimal @map("base_price") @db.Decimal(12, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(12, 2)
  untrackedUnitCost Decimal? @map("untracked_unit_cost") @db.Decimal(14, 4)
  allocations SaleItemLotAllocation[]
  movements StockMovement[]
  lineDiscount Decimal @default(0) @map("line_discount") @db.Decimal(12,2)
  billDiscountShare Decimal @default(0) @map("bill_discount_share") @db.Decimal(12,2)
  returns SaleReturnItem[]

  @@unique([saleId, lineNumber])
  @@map("sale_items")
}

model SaleItemLotAllocation {
  id String @id @default(uuid()) @db.Uuid
  saleItemId String @map("sale_item_id") @db.Uuid
  saleItem SaleItem @relation(fields: [saleItemId], references: [id])
  lotId String @map("lot_id") @db.Uuid
  lot StockLot @relation(fields: [lotId], references: [id])
  quantityAllocated Decimal @map("quantity_allocated") @db.Decimal(12, 3)
  unitCostSnapshot Decimal @map("unit_cost_snapshot") @db.Decimal(14, 4)
  position Int @default(0)
  returns SaleReturnAllocation[]

  @@unique([saleItemId, lotId])
  @@map("sale_item_lot_allocations")
}

model SalePayment {
  id String @id @default(uuid()) @db.Uuid
  saleId String @map("sale_id") @db.Uuid
  sale Sale @relation(fields: [saleId], references: [id])
  lineNumber Int @map("line_number")
  method String @db.VarChar(16)
  amount Decimal @db.Decimal(12, 2)
  tendered Decimal? @db.Decimal(12, 2)
  change Decimal? @db.Decimal(12, 2)
  reference String? @db.VarChar(120)
  refunds SaleRefund[]

  @@unique([saleId, lineNumber])
  @@map("sale_payments")
}

model SaleRequest {
  storeId String @map("store_id") @db.Uuid
  store Store @relation(fields: [storeId], references: [id])
  idempotencyKey String @map("idempotency_key") @db.Uuid
  payloadHash String @map("payload_hash") @db.Char(64)
  saleId String @unique @map("sale_id") @db.Uuid
  sale Sale @relation(fields: [saleId], references: [id])

  @@id([storeId, idempotencyKey])
  @@map("sale_requests")
}

model Member {
  id String @id @default(uuid()) @db.Uuid
  storeId String @map("store_id") @db.Uuid
  store Store @relation(fields: [storeId], references: [id])
  number String @db.VarChar(50)
  name String @db.VarChar(120)
  barcode String? @db.VarChar(100)
  phone String? @db.VarChar(10)
  address String? @db.VarChar(400)
  nationalIdEncrypted String? @map("national_id_encrypted")
  joinedOn DateTime? @map("joined_on") @db.Date
  isActive Boolean @default(true) @map("is_active")
  sales Sale[]
  purchaseLedger MemberPurchaseLedger[]
  shareAccount ShareAccount?
  dividendResults DividendResult[]
  rebateResults PurchaseRebateResult[]
  payoutObligations PayoutObligation[]

  @@unique([storeId, number])
  @@unique([storeId, barcode])
  @@index([storeId, phone])
  @@map("members")
}

model ShareAccount {
  id String @id @default(uuid()) @db.Uuid
  memberId String @unique @map("member_id") @db.Uuid
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  shareValue Decimal @map("share_value") @db.Decimal(12,2)
  entries ShareTransaction[]

  @@map("share_accounts")
}

model ShareTransaction {
  id String @id @default(uuid()) @db.Uuid
  shareAccountId String @map("share_account_id") @db.Uuid
  account ShareAccount @relation(fields: [shareAccountId], references: [id], onDelete: Restrict)
  transactionType String @map("transaction_type") @db.VarChar(16)
  shareQuantity Int @map("share_quantity")
  unitValue Decimal @map("unit_value") @db.Decimal(12,2)
  totalAmount Decimal @map("total_amount") @db.Decimal(12,2)
  effectiveDate DateTime @map("effective_date") @db.Date
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  approvedBy String @map("approved_by") @db.Uuid
  approver User @relation(fields: [approvedBy], references: [id], onDelete: Restrict)
  reason String @db.VarChar(300)
  transferId String? @map("transfer_id") @db.Uuid
  request ShareRequest?

  @@index([shareAccountId, effectiveDate, recordedAt, id], map: "share_transactions_share_account_id_effective_date_recorde_idx")
  @@unique([transferId, shareAccountId])
  @@map("share_transactions")
}

model ShareRequest {
  storeId String @map("store_id") @db.Uuid
  key String @db.Uuid
  fingerprint String @db.Char(64)
  transactionId String @unique @map("transaction_id") @db.Uuid
  entry ShareTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@id([storeId, key])
  @@map("share_requests")
}

model MemberPurchaseLedger {
  id String @id @default(uuid()) @db.Uuid
  memberId String @map("member_id") @db.Uuid
  member Member @relation(fields: [memberId], references: [id])
  saleId String? @unique @map("sale_id") @db.Uuid
  sale Sale? @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleReturnId String? @unique @map("sale_return_id") @db.Uuid
  saleReturn SaleReturn? @relation(fields: [saleReturnId], references: [id], onDelete: Restrict)
  transactionType String @map("transaction_type") @db.VarChar(12)
  grossAmount Decimal @map("gross_amount") @db.Decimal(12,2)
  netEligibleAmount Decimal @map("net_eligible_amount") @db.Decimal(12,2)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  adjustment PurchaseAdjustment?

  @@index([memberId, recordedAt])
  @@index([recordedAt, memberId])
  @@map("member_purchase_ledgers")
}

model DividendRule {
  id String @id @default(uuid()) @db.Uuid
  storeId String @map("store_id") @db.Uuid
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name String @db.VarChar(120)
  version Int
  formula String @db.VarChar(24)
  dividendRate Decimal @map("dividend_rate") @db.Decimal(7,4)
  rebateRate Decimal @map("rebate_rate") @db.Decimal(7,4)
  periods AccountingPeriod[]
  runs DividendRun[]

  @@unique([storeId, name, version])
  @@map("dividend_rules")
}

model AccountingPeriod {
  id String @id @default(uuid()) @db.Uuid
  storeId String @map("store_id") @db.Uuid
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name String @db.VarChar(120)
  startDate DateTime @map("start_date") @db.Date
  endDate DateTime @map("end_date") @db.Date
  status String @default("DRAFT") @db.VarChar(16)
  ruleId String @map("rule_id") @db.Uuid
  rule DividendRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  currentRunId String? @unique @map("current_run_id") @db.Uuid
  currentRun DividendRun? @relation("CurrentDividendRun", fields: [currentRunId], references: [id], onDelete: Restrict)
  lockedAt DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy String? @map("locked_by") @db.Uuid
  approver User? @relation(fields: [lockedBy], references: [id], onDelete: Restrict)
  runs DividendRun[] @relation("PeriodDividendRuns")
  obligations PayoutObligation[]
  adjustments PurchaseAdjustment[]

  @@index([storeId, startDate, endDate])
  @@map("accounting_periods")
}

model DividendRun {
  id String @id @default(uuid()) @db.Uuid
  periodId String @map("period_id") @db.Uuid
  period AccountingPeriod @relation("PeriodDividendRuns", fields: [periodId], references: [id], onDelete: Restrict)
  currentFor AccountingPeriod? @relation("CurrentDividendRun")
  ruleId String @map("rule_id") @db.Uuid
