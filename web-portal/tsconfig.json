{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/ui/*"],
      "@thepos/contracts": ["./src/contracts/index.ts"],
      "@thepos/shared": ["./src/shared/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
