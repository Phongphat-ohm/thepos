# bun run db:up starts a local-only development database.
POSTGRES_USER=thepos
POSTGRES_PASSWORD=thepos_dev
POSTGRES_DB=thepos
POSTGRES_PORT=54329
DATABASE_URL=postgresql://thepos:thepos_dev@127.0.0.1:54329/thepos
# For production least-privilege roles (use separate DB roles in docker-compose.prod.yml):
# API_DATABASE_URL=postgresql://thepos_app:change_me@postgres:5432/thepos
# MIGRATION_DATABASE_URL=postgresql://thepos_owner:change_me@postgres:5432/thepos
# BACKUP_DATABASE_URL=postgresql://thepos_backup:change_me@postgres:5432/thepos
API_HOST=127.0.0.1
API_PORT=3000
# Trusted reverse-proxy IPs or IPv4 CIDRs (for Caddy / internal load balancer):
# TRUSTED_PROXY_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.1,::1
# BACKUP_RETENTION_DAYS=30
# Generate distinct random values. See README.
JWT_SECRET=
BOOTSTRAP_SECRET=
# A separate, persistent 32-byte hex key. Required to save member national IDs.
# MEMBER_ENCRYPTION_KEY=
# Discrepancies above this amount require a manager PIN when closing a cash shift.
CASH_VARIANCE_LIMIT=0.00
# Optional fixed codes for server admin web console and Desktop connection (auto-generated on startup if empty).
# SERVER_CONSOLE_CODE=
# SERVER_CONNECT_SECRET=
# Comma-separated allowed origins for Central Web Portal CORS (e.g. https://web.example.com).
# CORS_ORIGINS=
# Set to true only if this server should also serve apps/desktop/dist static files.
SERVE_WEB_DIST=false
# Set to the PostgreSQL admin/development connection when running integration tests.
TEST_DATABASE_URL=
